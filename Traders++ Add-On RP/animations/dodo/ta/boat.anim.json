{
	"format_version": "1.8.0",
	"animations": {
		"animation.dodo_ta.boat.idle": {
			"loop": true,
			"bones": {
				"bone": {
					"rotation": [0, 0, "Math.cos(query.anim_time*100)*2"]
				}
			}
		},
		"animation.dodo_ta.boat.steer": {
			"loop": true,
			"bones": {
				"bone7": {
					"rotation": [0, 0, "Math.clamp(query.yaw_speed * -0.3, -60, 60)"]
				},
				"steer": {
					"rotation": [0, "Math.clamp(query.yaw_speed * -0.3, -60, 60)", 0]
				}
			}
		},
		"animation.dodo_ta.boat.water_fix": {
			"loop": true,
			"bones": {
				"Main_bone": {
					"position": [0, 5, 0]
				}
			}
		}
	}
}