{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dodo_ta.move": {
            "states": {
                "default": {
					"animations" : [ "idle" ],
                    "transitions": [
                        { "move": "query.modified_move_speed >= 0.1" }
                    ],
					"blend_transition": 0.3
                },
                "move": {
					"animations" : [ "move" ],
                    "transitions": [
                        { "default": "query.modified_move_speed < 0.1" }
					],
					"blend_transition": 0.3
				}
			}
        },
        "controller.animation.dodo_ta.move_ocean": {
            "states": {
                "default": {
					"animations" : [ "idle" ],
                    "transitions": [
                        { "move": "query.modified_move_speed >= 0.1" },
                        { "idle_water": "query.modified_move_speed < 0.1 && !query.is_on_ground" }
                    ],
					"blend_transition": 0.3
                },
                "idle_water": {
					"animations" : [ "idle_water" ],
                    "transitions": [
                        { "move": "query.modified_move_speed >= 0.1" },
                        { "default": "query.modified_move_speed < 0.1 && query.is_on_ground" }
					],
					"blend_transition": 0.3
				},
                "move": {
					"animations" : [ "move" ],
                    "transitions": [
                        { "default": "query.modified_move_speed < 0.1 && query.is_on_ground" },
                        { "idle_water": "query.modified_move_speed < 0.1 && !query.is_on_ground" }
					],
					"blend_transition": 0.3
				}
			}
        }
    }
}