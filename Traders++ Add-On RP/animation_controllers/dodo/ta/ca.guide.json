{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dodo_ta.guide.controls": {
            "states": {
                "default": {
					"animations" : [ "open" ],
                    "transitions": [
                        {
                            "standby": "query.all_animations_finished"
                        }
                    ]
                },
                "standby": {
					"animations" : [ "standby" ],
                    "transitions": [
                        {
                            "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'dodo_ta:guide')"
                        },
                        {
                            "next_page": "query.is_using_item && !query.is_sneaking"
                        },
                        {
                            "previous_page": "query.is_using_item && query.is_sneaking"
                        }
					]
				},
                "next_page": {
					"animations" : [ "next_page" ],
                    "transitions": [
                        {
                            "standby": "query.all_animations_finished && !query.is_using_item"
                        }
					],
					"on_exit": [
						"variable.dodo_ta_page=math.mod((variable.dodo_ta_page + 1), 11);"
					]
				},
                "previous_page": {
					"animations" : [ "previous_page" ],
                    "transitions": [
                        {
                            "standby": "query.all_animations_finished && !query.is_using_item"
                        }
					],
					"on_entry": [
						"variable.dodo_ta_page=math.mod(((variable.dodo_ta_page + 11) - 1), 11);"
					]
				}
			}
        }
    }
}