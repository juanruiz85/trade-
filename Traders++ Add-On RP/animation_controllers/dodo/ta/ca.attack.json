{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dodo_ta.attack": {
            "states": {
                "default": {
                    "transitions": [
                        { "attack": "variable.attack_time >= 0.1" }
                    ],
					"blend_transition": 0.3
                },
                "attack": {
					"animations" : [ "attack" ],
                    "transitions": [
                        { "default": "variable.attack_time < 0.1 && query.all_animations_finished" }
					],
					"blend_transition": 0.3
				}
			}
        }
    }
}