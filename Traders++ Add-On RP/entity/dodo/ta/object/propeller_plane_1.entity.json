				"texture": "dodo_ta_vehicles",
				"texture_index": 11
			},
			"render_controllers": [
				"controller.render.dodo_ta.furniture"
			],
			"geometry": {
				"default": "geometry.dodo_ta.propeller_plane"
			},
			"textures": {
				"default": "textures/dodo/ta/propeller_plane/1"
			},
			"scripts": {
				"animate": [
					{ "idle": "!query.is_moving && query.has_rider && query.is_on_ground" },
