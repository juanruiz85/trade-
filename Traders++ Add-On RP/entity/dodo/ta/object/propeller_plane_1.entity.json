					{ "on_ground": "query.is_moving && query.is_on_ground" },
					{ "in_air": "!query.is_on_ground" }
				]
			},
			"animations": {
				"idle": "animation.dodo_ta.propeller_plane.idle",
				"move": "animation.dodo_ta.propeller_plane.move",
