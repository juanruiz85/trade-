{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dodo_ta:warden_armor_2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 300
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, "math.cos(variable.emitter_age*70+70)*2 + 1.4", 0],
				"half_dimensions": [0.2, 0, 0.2],
				"direction": ["math.random(-1,1)", 0, "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.8,1.3)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(0,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(1,3)", 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.2 * variable.size * variable.particle_random_4", "0.2 * variable.size * variable.particle_random_4"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [16, 88],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF24F3FF",
						"1.0": "#000078FF"
					}
				}
			}
		}
	}
}