{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dodo_ta:secret_deals_target",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/dodo/ta/secret_deals_p"
			}
		},
		"curves": {
			"variable.size": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.95, 0, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 120,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "math.random(0.35,0.6)"
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.5, 0],
				"radius": 2.0,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.25
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-90, 90)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 1, 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [0, 32],
						"frames_per_second": 8,
						"max_frame": 2,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime * math.random(0, 0.8)",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.09": "#FF76FF00",
						"0.29": "#FF00FF04",
						"0.51": "#0000FF1E"
					}
				}
			}
		}
	}
}