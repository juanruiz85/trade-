{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dodo_ta:zombie_plushie",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
            "properties": {
                "dodo_ta:shake": {
                    "default": false,
                    "type": "bool"
                },
                "dodo_ta:use": {
                    "default": false,
                    "type": "bool"
                }
            },
            "scripts": {
                "animate": [
                    "shake",
                    "use"
                ]
            },
            "animations": {
                "shake": "controller.animation.dodo_ta.shake",
                "use": "controller.animation.dodo_ta.use"
            }
        },
        "components": {
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": false
			},
			"minecraft:custom_hit_test": {
				"hitboxes": [
					{
						"width": 0.8,
						"height": 0.8,
						"pivot": [ 0, 0.4, 0 ]
					}
				]
			},
			"minecraft:scale": { "value": 1.0 },
			"minecraft:collision_box": { "width": 0.0, "height": 0.0 },
			"minecraft:type_family": { "family": [ "furniture", "plushie", "traders_addon", "anti_kb" ] },
		    "minecraft:knockback_resistance": { "value": 1 },
			"minecraft:conditional_bandwidth_optimization": {},
            "minecraft:push_through": { "value": 1 },
			"minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
            "minecraft:health": { "value": 20, "max": 20 },
			"minecraft:skin_id": { "value": 0 },
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"on_damage":{
							"filters":{
								"all_of":[
									{ "test": "is_family", "subject": "other", "value": "player" }
								]
							},
							"event": "dodo_ta:shake"
						},
						"deals_damage": false
					},
					{ "on_damage": { "filters": {} }, "deals_damage": false }
				]
			},
			"minecraft:fire_immune": {}
        },
		"component_groups": {
			"invisible": {
				"minecraft:scale": { "value": 0.0 }
			},
			"use": {
				"minecraft:interact": {},
				"minecraft:timer": {
					"looping": true,
					"time": 0.5,
					"time_down_event":{
						"event": "dodo_ta:use_reset"
					}
				}
			},
			"use_reset": {
				"minecraft:interact": {
					"interactions": [
						{
							"on_interact": {
								"event": "dodo_ta:use",
								"target": "self"
							},
							"swing": true,
							"interact_text": "action.interact.use.dodo_ta.zombie_plushie"
						}
					]
				}
			},
			"minecraft:instant_despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [ "use_reset" ]
				}
			},
			"dodo_ta:shake": {
                "set_property": {
                    "dodo_ta:shake": true
                }
			},
			"dodo_ta:shake_reset": {
                "set_property": {
                    "dodo_ta:shake": false
                }
			},
			"dodo_ta:use": {
				"add": {
					"component_groups": [ "use" ]
				},
                "set_property": {
                    "dodo_ta:use": true
                }
			},
			"dodo_ta:use_reset": {
				"add": {
					"component_groups": [ "use_reset" ]
				},
                "set_property": {
                    "dodo_ta:use": false
                }
			},
			"dodo_ta:invisible": {
				"add": {
					"component_groups": [ "invisible" ]
				}
			},
			"minecraft:instant_despawn": {
				"add": {
					"component_groups": [ "minecraft:instant_despawn" ]
				}
			}
		}
	}
}