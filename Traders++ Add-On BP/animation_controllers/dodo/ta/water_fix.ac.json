{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dodo_ta.water_fix": {
            "states": {
                "default": {
                    "transitions": [
                        { "in_water": "query.is_in_water" },
                        { "not_in_water": "!query.is_in_water" }
                    ]
                },
                "in_water": {
                    "transitions": [{ "default": "!query.is_in_water" }],
                    "on_entry": [ "@s dodo_ta:not_in_water" ]
				},
                "not_in_water": {
                    "transitions": [{ "default": "query.is_in_water" }],
                    "on_entry": [ "@s dodo_ta:in_water" ]
				}
			}
        }
    }
}