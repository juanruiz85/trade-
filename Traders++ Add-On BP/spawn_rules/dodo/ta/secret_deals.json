{
  "format_version": "1.17.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "dodo_ta:secret_deals_trader",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_block_filter": [
          "minecraft:stone",
          "minecraft:granite",
          "minecraft:polished_granite",
          "minecraft:diorite",
          "minecraft:polished_diorite",
          "minecraft:andesite",
          "minecraft:polished_andesite",
          "minecraft:snow",
          "minecraft:snow_layer",
          "minecraft:packed_ice",
          "minecraft:gravel"
        ],
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:weight": {
          "default": 4
        },
        "minecraft:density_limit": {
          "surface": 1
        },
        "minecraft:biome_filter": {
          "any_of": [
            {"test": "has_biome_tag", "operator": "==", "value": "mountain"},
            {"test": "has_biome_tag", "operator": "==", "value": "snowy_slopes"},
            {"test": "has_biome_tag", "operator": "==", "value": "jagged_peaks"},
            {"test": "has_biome_tag", "operator": "==", "value": "frozen_peaks"}
          ]
        }
      }
    ]
  }
}